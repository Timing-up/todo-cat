{
  "name": "todo-cat",
  "productName": "Todo Cat",
  "version": "0.2.0",
  "description": "Todo Cat — 桌面悬浮待办、白纸执行与小猫陪伴 (macOS)",
  "main": "src/main/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/engine.test.js test/store.test.js",
    "e2e": "node scripts/e2e.js",
    "package:mac": "electron-packager . \"Todo Cat\" --platform=darwin --arch=arm64,x64 --out=dist --overwrite --app-bundle-id=com.todocat.app --icon=build/icon.icns --ignore=\"^/dist\" --ignore=\"^/test\" --ignore=\"^/e2e-shots\" --ignore=\"^/scripts\" && node scripts/sign-mac.js",
    "package:win": "electron-packager . \"Todo Cat\" --platform=win32 --arch=x64 --out=dist --overwrite --icon=build/icon.ico --ignore=\"^/dist\" --ignore=\"^/test\" --ignore=\"^/e2e-shots\" --ignore=\"^/scripts\""
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.3"
  }
}
